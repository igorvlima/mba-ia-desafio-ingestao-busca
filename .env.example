# Se apenas uma chave estiver preenchida, o provedor é detectado automaticamente.
# Se houver várias, informe: openai, google ou openrouter.
AI_PROVIDER=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Alternativa à chave inline: caminho de arquivo contendo somente a chave.
OPENROUTER_API_KEY_FILE=

# Opcionais: vazio usa os modelos padrão do provedor escolhido.
LLM_MODEL=
EMBEDDING_MODEL=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
COLLECTION_NAME=pdf_documents
PDF_PATH=document.pdf
